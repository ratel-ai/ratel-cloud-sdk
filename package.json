{
  "name": "@ratel-ai/cloud-sdk",
  "version": "0.2.0-rc.1",
  "description": "Management & supervised self-improvement client for Ratel Cloud — catalog writes, intent analysis, and skill-suggestion review over the cloud API, plus the OpenTelemetry destination on /otel. Dependency-free at the root; pure HTTP, no native addon.",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.28.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "default": "./dist/otel/index.js"
    }
  },
  "license": "MIT",
  "author": "Agentified",
  "homepage": "https://github.com/ratel-ai/ratel-cloud-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratel-ai/ratel-cloud-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ratel-ai/ratel-cloud-sdk/issues"
  },
  "keywords": [
    "skills",
    "skill-catalog",
    "ai-agents",
    "llm",
    "context-engineering",
    "opentelemetry",
    "otlp",
    "telemetry",
    "ratel"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run",
    "example:e2e": "node examples/e2e.mjs",
    "example:ui": "node examples/ui/server.mjs"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.3.0 <1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-proto": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  }
}
