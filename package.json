{
  "name": "@ratel-ai/cloud-sdk",
  "version": "0.2.0",
  "description": "Management & supervised self-improvement client for Ratel Cloud — catalog writes, intent analysis, and skill-suggestion review over the cloud API. Pure HTTP, no native addon.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "license": "MIT",
  "author": "Agentified",
  "homepage": "https://github.com/ratel-ai/ratel-cloud-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratel-ai/ratel-cloud-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ratel-ai/ratel-cloud-sdk/issues"
  },
  "keywords": [
    "skills",
    "skill-catalog",
    "ai-agents",
    "llm",
    "context-engineering",
    "ratel"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run",
    "example:e2e": "node examples/e2e.mjs",
    "example:ui": "node examples/ui/server.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  }
}
